#!/usr/bin/env python3
"""Print a structured JSON summary of available tools, runtimes, and exploit resources.

This script is mounted into the sandbox at /opt/pikaqiu-tools/env-info.
It can be updated without rebuilding the Docker image.
"""
import subprocess
import json
import shutil
import os
import glob as glob_mod
from pathlib import Path


SCRIPT_DIR = Path(__file__).resolve().parent
CATALOG_PATH = SCRIPT_DIR / "tool_catalog.json"
FLAG_PATHS_PATH = SCRIPT_DIR / "flag-paths.txt"
SANDBOX_FLAG_PATHS_PATH = "/opt/pikaqiu-tools/flag-paths.txt"


def ver(cmd, timeout=5):
    """Run a command and return its first output line."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        out = (r.stdout + r.stderr).strip().splitlines()
        return out[0][:120] if out else "ok"
    except FileNotFoundError:
        return None
    except Exception as e:
        return f"error: {e}"


def check_tool(name, version_cmd=None):
    """Check if a tool exists and optionally get its version."""
    path = shutil.which(name)
    if not path:
        return None
    if version_cmd:
        return ver(version_cmd)
    return path


def safe_count(command: str, timeout: int = 10, default: int = 0) -> int:
    try:
        out = subprocess.run(
            ["bash", "-c", command],
            capture_output=True,
            text=True,
            timeout=timeout,
        ).stdout.strip()
        return int(out or str(default))
    except Exception:
        return default


def load_tool_catalog():
    try:
        return json.loads(CATALOG_PATH.read_text(encoding="utf-8"))
    except Exception:
        return {}


def load_flag_path_dictionary():
    try:
        lines = [
            line.strip()
            for line in FLAG_PATHS_PATH.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
    except Exception:
        return {}

    absolute_paths = [line for line in lines if line.startswith("/")]
    relative_paths = [line for line in lines if not line.startswith("/")]
    return {
        "path": str(FLAG_PATHS_PATH),
        "sandbox_path": SANDBOX_FLAG_PATHS_PATH,
        "count": len(lines),
        "absolute_count": len(absolute_paths),
        "relative_count": len(relative_paths),
        "sample": lines[:12],
        "usage": "Small first-pass CTF flag path dictionary for targeted HTTP checks or shell/RCE file reads before broad find/grep.",
    }


def first_existing_path(paths):
    for raw in paths or []:
        path = os.path.expanduser(str(raw))
        if os.path.exists(path):
            return path
    return ""


def first_available_command(commands):
    for raw in commands or []:
        command = str(raw)
        if os.path.isabs(command) and os.path.exists(command):
            return command, command
        path = shutil.which(command)
        if path:
            return command, path
    return "", ""


def short_text(value, limit=140):
    text = " ".join(str(value or "").split())
    return text if len(text) <= limit else text[: limit - 3] + "..."


def compact_tool_guidance(catalog):
    """Return a prompt-friendly tool map before verbose runtime details."""
    if not catalog:
        return {}

    guidance = catalog.get("guidance", {})
    out = {
        "rule": guidance.get("rule", "Pick the smallest suitable tool and check help first."),
        "long_running": guidance.get(
            "long_running",
            "Commands run under the mission command timeout; save output to files when results need later inspection.",
        ),
        "categories": [],
    }

    for category in catalog.get("categories", []):
        tools = []
        source_tools = []
        for tool in category.get("tools", []):
            name = tool.get("name", "")
            command, _path = first_available_command(tool.get("commands", []))
            source_path = first_existing_path(tool.get("paths", []))
            if command:
                tools.append(f"{name}:{command}")
            elif source_path:
                source_tools.append(f"{name}:{source_path}")

        if not tools and not source_tools:
            continue

        item = {
            "id": category.get("id", ""),
            "when": short_text(category.get("when", "")),
            "tools": tools[:10],
        }
        if source_tools:
            item["source_or_windows_tools"] = source_tools[:6]
        examples = category.get("examples", [])
        if examples:
            item["examples"] = [short_text(example, limit=120) for example in examples[:1]]
        out["categories"].append(item)

    return out


info = {}
